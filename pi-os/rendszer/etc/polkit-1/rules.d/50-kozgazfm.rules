polkit.addRule(function(action, subject) {
    var engedett = ["org.freedesktop.login1.reboot", "org.freedesktop.login1.reboot-multiple-sessions",
                    "org.freedesktop.login1.power-off", "org.freedesktop.login1.power-off-multiple-sessions",
                    "org.freedesktop.timedate1.set-ntp"];
    if (subject.user == "kozgazfm" && engedett.indexOf(action.id) >= 0) {
        return polkit.Result.YES;
    }
});
